cu:Floor3_CHW_assumed a brick:Chilled_Water_Loop ;
    rdfs:label "Floor 3 chilled-water supply (assumed)" ;
    rdfs:comment "ASSUMED – topology not in the dataset; confirm with facilities" ;
    brick:feeds cu:F3_Z1_AC1,
        cu:F3_Z1_AC2,
        cu:F3_Z1_AC3,
