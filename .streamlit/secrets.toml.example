# Copy this file to .streamlit/secrets.toml (same folder) and paste your own key between the quotes.
# secrets.toml is git-ignored: never commit a real key.

# Free key from https://aistudio.google.com -> "Get API key". Used by the "Ask the data" chatbot.
GEMINI_API_KEY = "paste-your-key-here"

# Optional: use a different Gemini model.
# GEMINI_MODEL = "gemini-3.5-flash-lite"
